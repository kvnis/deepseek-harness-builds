+/**
+ * Copy Host output to the Desktop console without making that optional destination fatal.
+ * @param source - Host stdout capture, when the child runs with a piped stdout.
+ */
+function forwardHostOutput(source: NodeJS.ReadableStream | null | undefined): void {
+  if (source === null || source === undefined) return
+  let writable = true
+  process.stdout.on('error', () => { writable = false })
+  source.on('data', (chunk: Buffer | string) => {
+    if (!writable) return
+    try { process.stdout.write(chunk) }
+    catch { writable = false }
+  })
+}
