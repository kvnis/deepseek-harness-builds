new file mode 100644
index 00000000..da81f25d
--- /dev/null
+++ b/apps/desktop/scripts/appimage-update-info.ts
@@ -0,0 +1,96 @@
+/** Write AppImage update information into the runtime's .upd_info section. */
+
+import { closeSync, openSync, readSync, writeSync } from 'node:fs'
+import { resolve } from 'node:path'
+
+const ELF_HEADER_SIZE = 64
+const ELF_SECTION_HEADER_SIZE = 64
+const ELF_CLASS_64 = 2
+const ELF_DATA_LSB = 1
+const UPDATE_INFO_SECTION = '.upd_info'
+
+interface SectionHeader {
+  readonly name: number
+  readonly offset: bigint
+  readonly size: bigint
+}
+
+interface SectionTable {
+  readonly headers: readonly SectionHeader[]
+  readonly namesIndex: number
+}
+
+function readAt(fd: number, position: number, length: number): Buffer {
+  const buffer = Buffer.alloc(length)
+  const read = readSync(fd, buffer, 0, length, position)
+  if (read !== length) throw new Error('desktop AppImage: truncated ELF file')
+  return buffer
+}
+
+function sectionHeaders(fd: number): SectionTable {
+  const header = readAt(fd, 0, ELF_HEADER_SIZE)
+  if (header.readUInt32BE(0) !== 0x7f454c46) throw new Error('desktop AppImage: not an ELF file')
+  if (header[4] !== ELF_CLASS_64 || header[5] !== ELF_DATA_LSB) {
+    throw new Error('desktop AppImage: expected a 64-bit little-endian AppImage runtime')
+  }
+  const tableOffset = Number(header.readBigUInt64LE(0x28))
+  const entrySize = header.readUInt16LE(0x3a)
+  const entryCount = header.readUInt16LE(0x3c)
+  const namesIndex = header.readUInt16LE(0x3e)
+  if (entrySize !== ELF_SECTION_HEADER_SIZE || entryCount === 0 || namesIndex >= entryCount) {
+    throw new Error('desktop AppImage: invalid ELF section table')
+  }
+  const table = readAt(fd, tableOffset, entrySize * entryCount)
+  const headers = Array.from({ length: entryCount }, (_, index) => {
+    const offset = index * entrySize
+    return {
+      name: table.readUInt32LE(offset),
+      offset: table.readBigUInt64LE(offset + 0x18),
+      size: table.readBigUInt64LE(offset + 0x20),
+    }
+  })
+  return { headers, namesIndex }
+}
+
+function findSection(fd: number, table: SectionTable, name: string): SectionHeader | undefined {
+  const namesHeader = table.headers[table.namesIndex]
+  if (namesHeader === undefined) throw new Error('desktop AppImage: missing ELF section name table')
+  const names = readAt(fd, Number(namesHeader.offset), Number(namesHeader.size))
+  return table.headers.find((header) => {
+    const end = names.indexOf(0, header.name)
+    return end !== -1 && names.toString('utf8', header.name, end) === name
+  })
+}
+
+/**
+ * Write an AppImage update information string without moving any file data.
+ * @param path - AppImage whose runtime exposes a `.upd_info` section.
+ * @param updateInfo - AppImageUpdate-format string, for example `gh-releases-zsync|owner|repo|latest-pre|name*.AppImage`.
+ * @returns Nothing; the section is rewritten in place when its content differs.
+ */
+export function writeAppImageUpdateInfo(path: string, updateInfo: string): void {
+  if (updateInfo === '' || updateInfo.includes('\0') || updateInfo.includes('\n')) {
+    throw new Error('desktop AppImage: update information must be a nonempty single line')
+  }
+  const encoded = Buffer.from(`${updateInfo}\0`)
+  const fd = openSync(path, 'r+')
+  try {
+    const section = findSection(fd, sectionHeaders(fd), UPDATE_INFO_SECTION)
+    if (section === undefined) throw new Error(`desktop AppImage: ${path} has no ${UPDATE_INFO_SECTION} section`)
+    if (BigInt(encoded.length) > section.size) {
+      throw new Error(`desktop AppImage: update information exceeds the ${String(section.size)}-byte section`)
+    }
+    const offset = Number(section.offset)
+    if (!readAt(fd, offset, encoded.length).equals(encoded)) writeSync(fd, encoded, 0, encoded.length, offset)
+  } finally {
+    closeSync(fd)
+  }
+}
+
+if (process.argv[1] !== undefined && import.meta.filename === resolve(process.argv[1])) {
+  const [path, ...words] = process.argv.slice(2)
+  if (path === undefined || words.length === 0) {
+    throw new Error('usage: appimage-update-info.ts <AppImage> <update information>')
+  }
+  writeAppImageUpdateInfo(path, words.join(' '))
+}
