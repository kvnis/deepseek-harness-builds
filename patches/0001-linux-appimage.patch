@@ -0,0 +1,51 @@
+/** Replace sharp's native Linux build with its WebAssembly build for the Electron runtime. */
+
+import { cpSync, existsSync, mkdirSync, readdirSync, readFileSync, rmSync, writeFileSync } from 'node:fs'
+import { createRequire } from 'node:module'
+import { join } from 'node:path'
+
+/** Packages installed beside sharp's WebAssembly module. */
+const COMPANIONS = [['@emnapi', 'runtime'], [undefined, 'tslib']] as const
+
+function packageVersion(path: string): string {
+  const manifest = JSON.parse(readFileSync(path, 'utf8')) as { version?: unknown }
+  if (typeof manifest.version !== 'string') throw new Error(`desktop runtime: ${path} has no version`)
+  return manifest.version
+}
+
+function copyPackage(source: string, destination: string): void {
+  if (!existsSync(destination)) cpSync(source, destination, { recursive: true, dereference: true })
+}
+
+/**
+ * Install sharp's WebAssembly module and remove the native Linux prebuild it replaces.
+ *
+ * Electron's Linux binary leaks the system GLib symbols into its process, and sharp's
+ * native libvips carries another GLib; decoding a picture then aborts (electron#46323).
+ * sharp resolves `@img/sharp-wasm32` once the platform prebuild is absent.
+ * @param options - Runtime root, pnpm staging directory, and the pnpm runner used for runtime installs.
+ * @returns Resolves after the runtime resolves sharp's WebAssembly module.
+ */
+export async function stageLinuxSharpWasm(options: {
+  readonly root: string
+  readonly staging: string
+  readonly pnpm: (args: readonly string[], cwd: string) => Promise<void>
+}): Promise<void> {
+  const modules = join(options.root, 'node_modules')
+  const version = packageVersion(join(modules, 'sharp', 'package.json'))
+  mkdirSync(options.staging, { recursive: true })
