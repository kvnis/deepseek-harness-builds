diff --git a/apps/desktop/scripts/linux-office-kit.ts b/apps/desktop/scripts/linux-office-kit.ts
new file mode 100644
index 00000000..2bc776eb
--- /dev/null
+++ b/apps/desktop/scripts/linux-office-kit.ts
@@ -0,0 +1,28 @@
+/** Keep the packaged LibreOffice kit on its WASM engine inside Electron's ASAR. */
+
+import { readFileSync, writeFileSync } from 'node:fs'
+import { join } from 'node:path'
+
+/** The kit treats only an undefined lookup as a missing engine package. */
+const PROBE = 'lstatSync(join(directory, name), { throwIfNoEntry: false }) !== void 0'
+
+/** Electron's ASAR filesystem returns null for a missing path, which the kit would read as present. */
+const PATCHED = 'lstatSync(join(directory, name), { throwIfNoEntry: false }) != null'
+
+/**
+ * Patch the engine-presence probe so Linux falls back to the installed WASM engine.
+ *
+ * No native Linux engine is published, and inside an ASAR the kit's `lstatSync` probe returns
+ * `null` for the missing package, which it mistakes for an incomplete installation.
+ * @param root - Materialized dsh runtime directory.
+ * @returns Nothing; throws when the expected probe is absent or ambiguous.
+ */
+export function patchLinuxOfficeKitEngineProbe(root: string): void {
+  const path = join(root, 'node_modules', '@deepseek-ai', 'libreoffice-kit', 'lib', 'index.js')
+  const source = readFileSync(path, 'utf8')
+  const occurrences = source.split(PROBE).length - 1
+  if (occurrences !== 1) {
+    throw new Error(`desktop runtime: expected one LibreOffice engine probe in ${path}, found ${occurrences}`)
+  }
+  writeFileSync(path, source.replace(PROBE, PATCHED))
+}
