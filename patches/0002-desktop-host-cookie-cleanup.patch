+++ b/apps/desktop/src/auth-cookie-hygiene.ts
@@ -0,0 +1,49 @@
+/** Drop the Host browser-session cookies that earlier launches left in the Desktop profile. */
+
+/** Cookie fields this module reads; Electron's `Cookie` carries them all. */
+export interface DesktopHostCookie {
+  domain?: string
+  name: string
+  path?: string
+  secure?: boolean
+}
+
+/** Minimal cookie-jar surface; Electron's `Cookies` satisfies it. */
+export interface DesktopHostCookieJar {
+  /** @param filter - selector fields; an empty object lists the whole jar. */
+  get(filter: { url?: string }): Promise<readonly DesktopHostCookie[]>
+  /** @param url - cookie origin. @param name - cookie name. */
+  remove(url: string, name: string): Promise<void>
+}
+
+/** Name prefix the Host mints its loopback session cookie under. */
+const HOST_COOKIE_PREFIX = 'dsh-auth-'
+
+/**
+ * Forget every Host authentication cookie before this launch authenticates its own.
+ *
+ * A Host mints one cookie per loopback authority and the port changes on every
+ * launch, so a cookie left by an earlier launch can never validate again. Nothing
+ * overwrites them either: Chromium scopes cookies by host and ignores the port,
+ * so the cookies of every launch pile up in the same `127.0.0.1` jar and the
+ * `Cookie` header eventually outgrows the Host's 16 KiB header limit, after which
+ * every start fails with `431 Request Header Fields Too Large` before the Host can
+ * answer and the shell reports `Desktop Host authentication failed`.
+ *
+ * The single-instance lock keeps this launch the profile's only owner, so nothing
+ * running can still depend on a Host cookie when this runs.
+ * @param jar - Desktop session cookie jar.
+ */
+export async function clearStaleHostCookies(jar: DesktopHostCookieJar): Promise<void> {
+  for (const cookie of await jar.get({})) {
+    if (!cookie.name.startsWith(HOST_COOKIE_PREFIX)) continue
+    const domain = cookie.domain ?? ''
+    /* Electron addresses a cookie by URL, so a cookie without a domain cannot be named. */
+    if (domain === '') continue
+    const host = domain.startsWith('.') ? domain.slice(1) : domain
+    const origin = `${cookie.secure === true ? 'https' : 'http'}://${host}${cookie.path ?? '/'}`
+    try {
+      await jar.remove(origin, cookie.name)
+    } catch (_error) { /* An unremovable cookie must not block the launch; the next start retries it. */ }
+  }
+}
