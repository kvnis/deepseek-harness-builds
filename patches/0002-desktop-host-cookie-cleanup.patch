diff --git a/apps/desktop/tests/auth-cookie-hygiene.spec.ts b/apps/desktop/tests/auth-cookie-hygiene.spec.ts
new file mode 100644
index 00000000..0e8fa8ac
--- /dev/null
+++ b/apps/desktop/tests/auth-cookie-hygiene.spec.ts
@@ -0,0 +1,44 @@
+import { expect, it } from 'vitest'
+import { clearStaleHostCookies, type DesktopHostCookie } from '../src/auth-cookie-hygiene.ts'
+
+function fakeJar(cookies: readonly DesktopHostCookie[], unremovable: readonly string[] = []) {
+  const calls: string[] = []
+  const filters: { url?: string }[] = []
+  return {
+    calls,
+    filters,
+    jar: {
+      get: async (filter: { url?: string }) => { filters.push(filter); return cookies },
+      remove: async (url: string, name: string) => {
+        if (unremovable.includes(name)) throw new Error('jar refused')
+        calls.push(`${url} ${name}`)
+      },
+    },
+  }
+}
+
+it('lists the whole jar and removes only Host cookies', async () => {
+  const { calls, filters, jar } = fakeJar([
+    { domain: '127.0.0.1', name: 'dsh-auth-a', path: '/', secure: false },
+    { domain: '.example.com', name: 'session', path: '/', secure: true },
+    { domain: '127.0.0.1', name: 'dsh-auth-b', path: '/app', secure: true },
+  ])
+  await clearStaleHostCookies(jar)
+  expect(filters).toEqual([{}])
+  expect(calls).toEqual(['http://127.0.0.1/ dsh-auth-a', 'https://127.0.0.1/app dsh-auth-b'])
+})
+
+it('strips the leading dot Chromium keeps on a domain cookie', async () => {
+  const { calls, jar } = fakeJar([{ domain: '.127.0.0.1', name: 'dsh-auth-c', path: '/', secure: false }])
+  await clearStaleHostCookies(jar)
+  expect(calls).toEqual(['http://127.0.0.1/ dsh-auth-c'])
+})
+
+it('keeps launching when the jar refuses one removal', async () => {
+  const { calls, jar } = fakeJar([
+    { domain: '127.0.0.1', name: 'dsh-auth-refused', path: '/', secure: false },
+    { domain: '127.0.0.1', name: 'dsh-auth-next', path: '/', secure: false },
+  ], ['dsh-auth-refused'])
+  await clearStaleHostCookies(jar)
+  expect(calls).toEqual(['http://127.0.0.1/ dsh-auth-next'])
+})
